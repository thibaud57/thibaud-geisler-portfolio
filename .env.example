# === App ===
NEXT_PUBLIC_SITE_URL=        # https://thibaud-geisler.com en prod | http://localhost:3000 en dev
LOG_LEVEL=                   # optionnel — fatal|error|warn|info|debug|trace|silent. Défaut : debug en dev, info en prod

# === Cloudflare R2 (assets, bucket privé, servi via /api/assets/[...path]) ===
R2_ACCOUNT_ID=               # Identifiant de compte Cloudflare, commun à tous les buckets
R2_ASSETS_ACCESS_KEY_ID=     # Token Object Read & Write restreint au bucket assets de CET environnement
R2_ASSETS_SECRET_ACCESS_KEY= # Secret du même token (affiché une seule fois à la création)
R2_ASSETS_BUCKET=            # Dev : portfolio-assets-dev | Prod : portfolio-assets
R2_ADMIN_ACCESS_KEY_ID=      # Token Object Read & Write restreint au bucket admin de CET environnement
R2_ADMIN_SECRET_ACCESS_KEY=  # Secret du même token (affiché une seule fois à la création)
R2_ADMIN_BUCKET=             # Dev : portfolio-admin-dev | Prod : portfolio-admin

# === Auth (espace admin : Better Auth + Google OAuth) ===
BETTER_AUTH_URL=             # Dev : http://localhost:3000 | Prod : https://thibaud-geisler.com
BETTER_AUTH_SECRET=          # Secret de signature (openssl rand -base64 32)
GOOGLE_CLIENT_ID=            # Client ID OAuth Google (Google Cloud Console)
GOOGLE_CLIENT_SECRET=        # Client Secret OAuth Google (Google Cloud Console)
ADMIN_EMAIL=                 # Email unique autorisé (whitelist single-user)

# === Database (dev local) ===
# POSTGRES_* : credentials init du Postgres local (lus par compose.override.yaml). Si modifiés, mettre à jour DATABASE_URL en conséquence.
# En prod Dokploy : ignorés (Postgres Database Dokploy a ses propres credentials, DATABASE_URL injectée via Dokploy UI).
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
# DATABASE_URL : utilisé par Prisma en dev natif (`just dev`). Host = localhost car compose.override expose le port 5432.
# `just docker-up` (profile validation) override automatiquement vers `postgres:5432` (DNS compose interne).
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio

# === SMTP ===
SMTP_HOST=
SMTP_PORT=                   # 587 (STARTTLS) | 465 (TLS)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_TO=

# === Calendly ===
# Une URL par locale (event types Calendly distincts FR/EN).
NEXT_PUBLIC_CALENDLY_URL_FR= # https://calendly.com/<slug>/<event-type-fr>
NEXT_PUBLIC_CALENDLY_URL_EN= # https://calendly.com/<slug>/<event-type-en>

# === Sécurité ===
IP_HASH_SALT=                # 16+ caractères — générer : openssl rand -hex 32

# === Sentry (monitoring d'erreurs — optionnel, laisser vide pour désactiver en local) ===
NEXT_PUBLIC_SENTRY_DSN=       # DSN du projet Sentry (Settings → Client Keys)
