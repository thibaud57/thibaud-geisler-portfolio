[
  {
    "name": "portfolio_search",
    "title": "Search portfolio records by name",
    "description": "Find portfolio records by an approximate name, case and accents ignored. Call this first: portfolio_fetch and portfolio_update need the id it returns. Returns { results: [{ entity, id, label, hint }] }, where hint tells two homonyms apart: the slug for a tag, the slug for a project (found by slug, French or English title).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Name or part of the name, case and accents ignored (e.g. \"societe acm\")."
        },
        "entities": {
          "description": "Record types to search. All by default.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "tag",
              "project"
            ]
          }
        },
        "limit": {
          "default": 10,
          "description": "Maximum hits, 1 to 50. Defaults to 10.",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "portfolio_fetch",
    "title": "Fetch a portfolio record",
    "description": "Fetch one portfolio record by id, with its links. For a tag: its icon and the projects that carry it (id, slug, French title, status), with their count. For a project: all its fields, its client company (id, name, logo) with the contract details, and its tags in display order; startedAt and endedAt are YYYY-MM-DD days. Call portfolio_search first to get the id. Returns an error naming the id if nothing matches. Dates with a time are ISO 8601 in Paris time, with their offset.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "entity": {
          "type": "string",
          "enum": [
            "tag",
            "project"
          ],
          "description": "Type of portfolio record to fetch."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Id of the record. Get it from portfolio_search first."
        }
      },
      "required": [
        "entity",
        "id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true
    }
  },
  {
    "name": "portfolio_query",
    "title": "List portfolio records with filters",
    "description": "List portfolio records of one entity, filtered, sorted and paginated. Use it to browse (e.g. all the tags of a category, or the draft projects); use portfolio_search to find one record by name. Returns { rows, total }: summary rows (a tag: id, slug, French and English names, category, icon, updated date; a project: id, slug, French and English titles, status, type, client company name, display order, updated date) and the total count before pagination. Page with offset. Tags sort by category in the order of the admin (expertise, AI, language, framework, database, infrastructure), then by display order. Projects sort by display order, as in the admin. Dates with a time are ISO 8601 in Paris time, with their offset.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "entity": {
          "type": "string",
          "enum": [
            "tag",
            "project"
          ],
          "description": "Type of portfolio record to list."
        },
        "filters": {
          "type": "object",
          "properties": {},
          "additionalProperties": {},
          "anyOf": [
            {
              "title": "tag",
              "description": "Filters.",
              "type": "object",
              "properties": {
                "kind": {
                  "description": "Only this category.",
                  "type": "string",
                  "enum": [
                    "LANGUAGE",
                    "FRAMEWORK",
                    "DATABASE",
                    "INFRA",
                    "AI",
                    "EXPERTISE"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "title": "project",
              "description": "Filters, combined with AND.",
              "type": "object",
              "properties": {
                "status": {
                  "description": "Only this status.",
                  "type": "string",
                  "enum": [
                    "DRAFT",
                    "PUBLISHED",
                    "ARCHIVED"
                  ]
                },
                "type": {
                  "description": "Only this type.",
                  "type": "string",
                  "enum": [
                    "CLIENT",
                    "PERSONAL"
                  ]
                },
                "companyId": {
                  "description": "Only the projects of this client company.",
                  "type": "string",
                  "minLength": 1
                },
                "tagId": {
                  "description": "Only the projects that carry this tag.",
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "Filters, all optional. The accepted filters depend on entity: use the branch titled with that entity."
        },
        "sort": {
          "description": "Sort key. Defaults to name.",
          "type": "string",
          "enum": [
            "name",
            "createdAt",
            "updatedAt"
          ]
        },
        "order": {
          "description": "Sort direction. Defaults to asc: for the name sort, asc follows the order of the admin.",
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "limit": {
          "description": "Page size, 1 to 100. Defaults to 20.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "description": "Number of rows to skip. Defaults to 0.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "entity"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "portfolio_create",
    "title": "Create a portfolio record",
    "description": "Create a portfolio record. Call portfolio_search first to check it does not exist yet. For a tag, slug, nameFr, nameEn and kind are required, and the tag goes last in its category. For a project, slug, titleFr, titleEn, descriptionFr, descriptionEn, type, formats, companyId and workMode are required; it is created as a DRAFT, last in the display order. A status PUBLISHED puts the project online at once (list, case study, sitemap), and serves the name, logo, website, sectors and size of its client company publicly. A personal project belongs to the company of type MA_SOCIETE. Returns the id, the slug and, for a project, its French title.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "entity": {
          "type": "string",
          "enum": [
            "tag",
            "project"
          ],
          "description": "Type of portfolio record to create."
        },
        "data": {
          "type": "object",
          "properties": {},
          "additionalProperties": {},
          "anyOf": [
            {
              "title": "tag",
              "description": "Fields of the tag to create. Required: slug, nameFr, nameEn and kind.",
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "description": "Unique URL identifier, at most 60 characters: lowercase letters, digits and single hyphens (e.g. \"next-js\"). Trimmed and lowercased like in the admin. Fixed once created."
                },
                "nameFr": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "French display name, at most 60 characters."
                },
                "nameEn": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "English display name, at most 60 characters."
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "LANGUAGE",
                    "FRAMEWORK",
                    "DATABASE",
                    "INFRA",
                    "AI",
                    "EXPERTISE"
                  ],
                  "description": "Category of the tag: EXPERTISE, AI, LANGUAGE, FRAMEWORK, DATABASE or INFRA."
                },
                "icon": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "custom:remotion",
                        "lucide:audio-waveform",
                        "lucide:bot",
                        "lucide:brain-circuit",
                        "lucide:bug",
                        "lucide:chevron-right",
                        "lucide:clapperboard",
                        "lucide:coffee",
                        "lucide:database",
                        "lucide:database-zap",
                        "lucide:film",
                        "lucide:ghost",
                        "lucide:image",
                        "lucide:laptop",
                        "lucide:message-circle",
                        "lucide:network",
                        "lucide:plug",
                        "lucide:scan-search",
                        "lucide:shield-ban",
                        "lucide:ship",
                        "lucide:sparkles",
                        "lucide:square-function",
                        "lucide:workflow",
                        "simple-icons:android",
                        "simple-icons:angular",
                        "simple-icons:anthropic",
                        "simple-icons:apachekafka",
                        "simple-icons:claude",
                        "simple-icons:datadog",
                        "simple-icons:docker",
                        "simple-icons:elasticsearch",
                        "simple-icons:express",
                        "simple-icons:fastapi",
                        "simple-icons:ffmpeg",
                        "simple-icons:github",
                        "simple-icons:githubactions",
                        "simple-icons:google",
                        "simple-icons:googlecloud",
                        "simple-icons:googlegemini",
                        "simple-icons:grafana",
                        "simple-icons:kubernetes",
                        "simple-icons:modelcontextprotocol",
                        "simple-icons:mongodb",
                        "simple-icons:n8n",
                        "simple-icons:nestjs",
                        "simple-icons:nextdotjs",
                        "simple-icons:nodedotjs",
                        "simple-icons:odoo",
                        "simple-icons:openrouter",
                        "simple-icons:perplexity",
                        "simple-icons:php",
                        "simple-icons:postgresql",
                        "simple-icons:pydantic",
                        "simple-icons:python",
                        "simple-icons:qdrant",
                        "simple-icons:react",
                        "simple-icons:scala",
                        "simple-icons:sentry",
                        "simple-icons:sonarqubeserver",
                        "simple-icons:spring",
                        "simple-icons:springboot",
                        "simple-icons:tauri",
                        "simple-icons:traefikproxy",
                        "simple-icons:typescript"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Icon key from the registry listed here. null means no icon (and clears it)."
                }
              },
              "required": [
                "slug",
                "nameFr",
                "nameEn",
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "title": "project",
              "description": "Fields of the project to create. Required: slug, titleFr, titleEn, descriptionFr, descriptionEn, type, formats, companyId and workMode.",
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "description": "Unique URL identifier of the public page, at most 80 characters: lowercase letters, digits and single hyphens (e.g. \"crm-freelance\"). Fixed once created."
                },
                "titleFr": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "French title, at most 120 characters."
                },
                "titleEn": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "English title, at most 120 characters."
                },
                "descriptionFr": {
                  "type": "string",
                  "minLength": 1,
                  "description": "French description, plain text."
                },
                "descriptionEn": {
                  "type": "string",
                  "minLength": 1,
                  "description": "English description, plain text."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "CLIENT",
                    "PERSONAL"
                  ],
                  "description": "CLIENT for a client project, PERSONAL for a personal one."
                },
                "status": {
                  "default": "DRAFT",
                  "type": "string",
                  "enum": [
                    "DRAFT",
                    "PUBLISHED",
                    "ARCHIVED"
                  ],
                  "description": "DRAFT (offline), PUBLISHED (online at once) or ARCHIVED (offline). Defaults to DRAFT at creation."
                },
                "formats": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "API",
                      "WEB_APP",
                      "MOBILE_APP",
                      "DESKTOP_APP",
                      "CLI",
                      "IA"
                    ]
                  },
                  "description": "At least one format among API, WEB_APP, MOBILE_APP, DESKTOP_APP, CLI, IA."
                },
                "startedAt": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Start day, YYYY-MM-DD. null clears it."
                },
                "endedAt": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "End day, YYYY-MM-DD, not before startedAt (the stored one when only endedAt is sent). null clears it."
                },
                "githubUrl": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "GitHub URL, http or https. null clears it."
                },
                "demoUrl": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "URL of the demo, http or https. null clears it."
                },
                "coverFilename": {
                  "default": null,
                  "description": "Key of the cover image, starting with \"projets/client/\" or \"projets/personal/\". Uploading is done in the admin. null clears it.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "caseStudyMarkdownFr": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Case study in markdown, French. Independent of the other language. null clears it."
                },
                "caseStudyMarkdownEn": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Case study in markdown, English. Independent of the other language. null clears it."
                },
                "tagIds": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Ids of the tags, in display order (get them from portfolio_search). On update, sending it replaces the whole list and leaving it out keeps the current tags."
                },
                "companyId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Id of the client company (get it from crm_search with the entity company). A personal project belongs to the company of type MA_SOCIETE."
                },
                "workMode": {
                  "type": "string",
                  "enum": [
                    "PRESENTIEL",
                    "HYBRIDE",
                    "REMOTE"
                  ],
                  "description": "PRESENTIEL, HYBRIDE or REMOTE."
                },
                "contractStatus": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "FREELANCE",
                        "CDI",
                        "STAGE",
                        "ALTERNANCE"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Contract of the mission: FREELANCE, CDI, STAGE or ALTERNANCE. null clears it."
                },
                "teamSize": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Number of people on the team, at least 1. null clears it."
                },
                "deliverablesCount": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Number of deliverables, 0 or more. Defaults to 1 at creation."
                }
              },
              "required": [
                "slug",
                "titleFr",
                "titleEn",
                "descriptionFr",
                "descriptionEn",
                "type",
                "formats",
                "companyId",
                "workMode"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Fields of the new record. They depend on entity: use the branch titled with that entity."
        }
      },
      "required": [
        "entity",
        "data"
      ],
      "additionalProperties": false
    }
  },
  {
