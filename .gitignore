# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (Prisma 7 génère le client dans le code source)
/src/generated/
# dumps de DB de dev (just db-dump)
dumps/

# IDE
.history/
# On versionne ce qui décrit le projet, pas ce qui décrit la machine
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Playwright MCP (screenshots, snapshots, logs de debug)
.playwright-mcp/

# Claude Code worktrees (créés dynamiquement lors des dispatches parallèles)
.claude/worktrees/

# Claude Code scheduling lock (PID + sessionId, recréé à chaque session)
.claude/scheduled_tasks.lock

# Superpowers (ledgers, briefs et review packages de subagent-driven-development)
.superpowers/

# design-sync : scripts, build et état machine. Seuls config.json et NOTES.md sont versionnés
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
# Exports ZIP de la maquette et du design system Claude Design, lus en local : la source en ligne fait foi, une copie versionnée vieillirait
.design-sync/maquette/
.design-sync/design-system/
